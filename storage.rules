rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && userProfile().active == true;
    }

    function director() {
      return activeUser() && userProfile().role == 'director';
    }

    match /organizations/{organizationId}/{allPaths=**} {
      allow read: if activeUser() && userProfile().organizationId == organizationId;
      allow write: if activeUser() && userProfile().organizationId == organizationId
        && (director() || request.resource.size < 20 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*|application/pdf|text/.*|application/zip');
      allow delete: if director();
    }
  }
}
